  "rootCauses": [
    "Native packager stamped signed vendor Node resources, removing Authenticode",
    "Audio .node imported VCRUNTIME140.dll but package assumed system installation",
    "Windows UpdateResource truncated MinGW COFF symbol/string tables and left stale pointers",
    "Native widget painting diverged from shared layout, image fit, text and DPR rules; UI snapshots recloned unchanged peers"
  ],
  "implementation": [
    "Preserve signed vendor Node bytes; bundle verified Microsoft app-local VC in runtime and audio module folders",
    "Game and C++ worker PE version/manifest before SHA256 signing+timestamp+Valid verification; final artifact hashes after all writes",
    "Require signing certificate for release; mark unsigned development builds explicitly",
    "Link initial worker resources and preserve/repoint COFF table across product metadata stamping",
    "DPI-aware native window sizing and HUD pixelRatio; shared visual helpers, text wrapping, image fit, 9slice, SVG reraster, WebP animation, opacity/transform/layout hit-test",
    "Per-instance once-per-tick immutable UI snapshot refresh and peer reuse",
    "Separate owned child CoreAudio session name/icon/group without editing vendor Node",
    "Bounded one/two translation units and source-count timeout; drain on cancellation",
    "Missing/blocked packaged C++ worker actionable window/log diagnostics"
  ],
