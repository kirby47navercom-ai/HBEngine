{
  "name": "hbengine-ui-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "node tools/generate-api.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node tools/check.mjs",
    "api:generate": "node tools/generate-api.mjs",
    "api:check": "node tools/generate-api.mjs --check",
    "test:native": "node tools/check-native.mjs",
    "test:runtime": "node tools/check-runtime.mjs",
    "test:host": "node tools/check-host.mjs",
    "test:project": "node tools/check-project.mjs",
    "test:server": "node tools/check-project.mjs --server",
    "test:library": "node tools/prepare-native.mjs && node tools/check-library.mjs",
    "test:assets": "node tools/check-assets.mjs",
    "desktop:build": "node tools/build-desktop.mjs",
    "test:launcher": "node tools/check-launcher.mjs",
    "test:hub-ui": "node tools/check-hub-ui.mjs",
    "test:session": "node tools/check-session.mjs",
    "test:desktop": "node tools/check-desktop.mjs",
    "test:windows": "node tools/check-window-workflow.mjs",
    "test:scene": "node tools/check-scene-editor.mjs && node tools/check-scene-runtime.mjs",
    "test:2d": "node tools/check-2d-workflow.mjs",
    "test:authoring": "node tools/check-authoring.mjs",
    "test:material": "node tools/check-material-workflow.mjs",
    "test:gameplay": "node tools/check-gameplay-workflow.mjs",
    "test:integration": "node tools/check-engine-integration.mjs",
    "test:editor-api": "node tools/check-editor-api.mjs",
    "engine": "node tools/hb.mjs",
    "test:headless": "node tools/check-headless.mjs",
    "run:project": "node tools/run-project.mjs",
    "test:systems": "node tools/check-scene-systems.mjs",
    "test:ui-audio": "node tools/prepare-native.mjs && node tools/check-ui-audio.mjs && node tools/check-audio-sources.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
